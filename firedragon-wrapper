#!/bin/sh
# Wrapper script for FireDragon Flatpak
# Uses the Flatpak runtime's dynamic linker to avoid host GLIBC version conflicts
# Fixes: GLIBC_2.42 not found on Fedora 42 and other older distros

# The Flatpak runtime's ld.so is at /usr/lib/ld-linux-x86-64.so.2
# We use it explicitly to ensure the binary uses the runtime's GLIBC

exec /usr/lib/ld-linux-x86-64.so.2 --library-path /usr/lib:/app/lib /app/lib/firedragon/firedragon "$@"